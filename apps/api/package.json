{
  "name": "@ice/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./src/lib/telemetry.ts watch src/main.ts",
    "build": "tsc",
    "start": "node --import ./dist/lib/telemetry.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/lib/migrate.ts"
  },
  "dependencies": {
    "@ice/core": "workspace:*",
    "@ice/schemas": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "express": "^4.19.2",
    "jose": "^5.9.6",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "twilio": "^5.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
