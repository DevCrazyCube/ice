# Application
NODE_ENV=development
LOG_LEVEL=info

# API
PORT=3001

# Database (Postgres — required)
DATABASE_URL=postgresql://user:password@localhost:5432/ice

# OIDC — required for login flow (leave blank in dev to get 503 on /auth/login)
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=ice-api
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_TOKEN_URL=
OIDC_AUTHORIZATION_URL=

# Session — symmetric key for signing session JWTs (HS256, min 32 chars)
SESSION_SECRET=

# Twilio — required for webhook signature verification
TWILIO_AUTH_TOKEN=
PUBLIC_WEBHOOK_URL=https://your-domain.com

# OpenTelemetry — optional; traces exported to OTLP collector if set
OTEL_EXPORTER_OTLP_ENDPOINT=
